boot_splash/fullsize=false
boot_splash/image="uid://cbmn7e5nyccx0"
config/icon="uid://bdbfdveksus1g"
boot_splash/minimum_display_time=715

[autoload]

DiscordManager="*res://scripts/discord_manager.gd"
